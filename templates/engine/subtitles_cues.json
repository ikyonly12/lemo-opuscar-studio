  },
  {
    "t0": 49.828,
    "t1": 50.85,
    "text": "dan macet total."
  },
  {
    "t0": 51.15,
    "t1": 53.55,
    "text": "Tuasnya bertubrukan dan tersangkut lagi!"
  },
  {
    "t0": 56.25,
    "t1": 58.05,
    "text": "Untuk memecahkan kebuntuan ini,"
  },
  {
    "t0": 58.05,
