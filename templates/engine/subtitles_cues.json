  },
  {
    "t0": 42.93,
    "t1": 45.868,
    "text": "Kelemahannya fatal: saat tombol ditekan cepat,"
  },
  {
    "t0": 45.868,
    "t1": 48.678,
    "text": "tuas-tuas besi berdekatan berayun bersamaan,"
  },
  {
    "t0": 48.678,
