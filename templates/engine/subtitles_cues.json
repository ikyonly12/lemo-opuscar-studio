    "text": "Kenapa tidak berurutan saja seperti A-B-C-D?"
  },
  {
    "t0": 18.99,
    "t1": 20.928,
    "text": "Banyak orang percaya mitos bahwa"
  },
  {
    "t0": 20.928,
    "t1": 22.867,
    "text": "keyboard sengaja dibuat lambat ."
  },
  {
    "t0": 22.867,
    "t1": 25.29,
    "text": "Padahal faktanya justru kebalikan total."
  },
  {
    "t0": 27.99,
    "t1": 30.248,
    "text": "Semua bermula dari krisis mekanis"
  },
  {
    "t0": 30.248,
    "t1": 32.438,
    "text": "di bengkel Milwaukee tahun 1873,"
  },
  {
    "t0": 32.438,
    "t1": 35.038,
    "text": "saat Christopher Latham Sholes merakit"
  },
  {
    "t0": 35.038,
    "t1": 36.27,
    "text": "mesin tik pertama."
  },
  {
    "t0": 36.57,
    "t1": 37.662,
    "text": "Pada rancangan awal,"
  },
  {
    "t0": 37.662,
    "t1": 39.955,
    "text": "batang-batang huruf dari logam menggantung"
  },
  {
    "t0": 39.955,
