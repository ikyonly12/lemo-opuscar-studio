  },
  {
    "t0": 6.771,
    "t1": 7.93,
    "text": "kaca ponsel cerdas."
  },
  {
    "t0": 8.23,
    "t1": 9.852,
    "text": "Namun pernahkah Anda heran,"
  },
  {
    "t0": 9.852,
    "t1": 12.016,
    "text": "mengapa susunan hurufnya begitu acak"
  },
  {
    "t0": 12.016,
    "t1": 13.518,
    "text": "dan huruf A diletakkan di"
  },
